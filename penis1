  <Title>oxy level support</Title>
  <Description />
  <Author>Jeb Kerman</Author>
  <WorkshopFileHandle>0</WorkshopFileHandle>
  <Instructions># d0 = Gas Sensor in the controlled room
# All oxygen supply active vents must be named exactly: Oxy Vent
# Optional indicator LEDs:
#   Oxy Vent On  - lights while the vents are enabled
#   Oxy Vent Off - lights while the vents are disabled
# Vents turn on below 20 kPa O2 partial pressure and off above 22 kPa.

define OxyVent HASH("StructureActiveVent")
define OxyVentName HASH("Oxy Vent")
define Led HASH("StructureLED")
define OxyVentOnLedName HASH("Oxy Vent On")
define OxyVentOffLedName HASH("Oxy Vent Off")
define O2On 20
define O2Off 22

alias GasSensor d0
alias Pressure r0
alias O2Ratio r1
alias O2Pressure r2
alias VentsOn r3
alias NeedO2 r4
alias EnoughO2 r5
alias VentsOff r6

move VentsOn 0
sbn OxyVent OxyVentName Mode 0
sbn OxyVent OxyVentName On VentsOn
seq VentsOff VentsOn 0
sbn Led OxyVentOnLedName On VentsOn
sbn Led OxyVentOffLedName On VentsOff

Main:
  l Pressure GasSensor Pressure
  l O2Ratio GasSensor RatioOxygen
  mul O2Pressure Pressure O2Ratio

  slt NeedO2 O2Pressure O2On
  sgt EnoughO2 O2Pressure O2Off
  bnez NeedO2 TurnOn
  bnez EnoughO2 TurnOff
  j Apply

TurnOn:
  move VentsOn 1
  j Apply

TurnOff:
  move VentsOn 0

Apply:
  sbn OxyVent OxyVentName Mode 0
  sbn OxyVent OxyVentName On VentsOn
  seq VentsOff VentsOn 0
  sbn Led OxyVentOnLedName On VentsOn
  sbn Led OxyVentOffLedName On VentsOff
  yield
  j Main
</Instructions>
</InstructionData>
